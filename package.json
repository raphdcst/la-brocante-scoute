{
  "name": "la-brocante-scoute",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@orpc/server": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "better-auth": "^1.4.18",
      "@orpc/client": "^1.12.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @la-brocante-scoute/db db:push",
    "db:studio": "turbo -F @la-brocante-scoute/db db:studio",
    "db:generate": "turbo -F @la-brocante-scoute/db db:generate",
    "db:migrate": "turbo -F @la-brocante-scoute/db db:migrate",
    "db:start": "turbo -F @la-brocante-scoute/db db:start",
    "db:watch": "turbo -F @la-brocante-scoute/db db:watch",
    "db:stop": "turbo -F @la-brocante-scoute/db db:stop",
    "db:down": "turbo -F @la-brocante-scoute/db db:down",
    "check": "oxlint && oxfmt --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@la-brocante-scoute/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@la-brocante-scoute/config": "workspace:*",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "bun@1.2.18"
}
